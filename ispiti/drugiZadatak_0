// ==========================================
// RJEŠENJE PRVOG ZADATKA (Dirigent)
// ==========================================
void Task1_Zad1(void *argument)
{
    for(;;)
    {
        vTaskSuspend(NULL);
        HAL_GPIO_WritePin(GPIOA, GPIO_PIN_1, GPIO_PIN_SET);
        for(int i=0; i<500000; i++){}
        HAL_GPIO_WritePin(GPIOA, GPIO_PIN_1, GPIO_PIN_RESET);
    }
}

void Task2_Zad1(void *argument)
{
    for(;;)
    {
        vTaskSuspend(NULL);
        HAL_GPIO_WritePin(GPIOA, GPIO_PIN_3, GPIO_PIN_SET);
        for(int i=0; i<500000; i++){}
        HAL_GPIO_WritePin(GPIOA, GPIO_PIN_3, GPIO_PIN_RESET);
    }
}

void Task3_Zad1(void *argument)
{
    for(;;)
    {
        vTaskSuspend(NULL);
        HAL_GPIO_WritePin(GPIOA, GPIO_PIN_5, GPIO_PIN_SET);
        for(int i=0; i<500000; i++){}
        HAL_GPIO_WritePin(GPIOA, GPIO_PIN_5, GPIO_PIN_RESET);
    }
}

void Task4_Dirigent(void *argument)
{
    for(;;)
    {
        // Traženi redoslijed: task1, task2, task1, task2, task3, task3
        vTaskResume(t1_handle);
        vTaskDelay(100);
        
        vTaskResume(t2_handle);
        vTaskDelay(100);
        
        vTaskResume(t1_handle);
        vTaskDelay(100);
        
        vTaskResume(t2_handle);
        vTaskDelay(100);
        
        vTaskResume(t3_handle);
        vTaskDelay(100);
        
        vTaskResume(t3_handle);
        vTaskDelay(1000); // Pauza prije idućeg ponavljanja kruga
    }
}

// ==========================================
// RJEŠENJE DRUGOG ZADATKA (Timer Interrupt)
// ==========================================

// Prekid tajmera (TIM1) glumi budilicu
void HAL_TIM_PeriodElapsedCallback(TIM_HandleTypeDef *htim)
{
    if (htim->Instance == TIM1)
    {
        brojac_sekundi++;
        
        // Nakon zadatog broja otkucaja (npr. svake 2 sekunde) budimo prvu lampicu
        if (brojac_sekundi >= 2)
        {
            brojac_sekundi = 0;
            vTaskResume(lampica1_handle);
        }
    }
}

void Task1_Lampica(void *argument)
{
    for(;;)
    {
        vTaskSuspend(NULL); // Čeka signal od tajmera
        
        // Pali lampicu 1 (pin A6)
        HAL_GPIO_WritePin(GPIOA, GPIO_PIN_6, GPIO_PIN_SET);
        for(int i=0; i<1000000; i++){}
        HAL_GPIO_WritePin(GPIOA, GPIO_PIN_6, GPIO_PIN_RESET);
        
        // Nakon što se ugasila, odmah pali drugu lampicu (krug se nastavlja)
        vTaskResume(lampica2_handle);
    }
}

void Task2_Lampica(void *argument)
{
    for(;;)
    {
        vTaskSuspend(NULL); // Čeka da ga Task1_Lampica probudi
        
        // Pali lampicu 2 (pin A7)
        HAL_GPIO_WritePin(GPIOA, GPIO_PIN_7, GPIO_PIN_SET);
        for(int i=0; i<1000000; i++){}
        HAL_GPIO_WritePin(GPIOA, GPIO_PIN_7, GPIO_PIN_RESET);
        
        // Ovdje završava krug lampica, čekamo idući otkucaj tajmera
    }
}

/* USER CODE END 4 */

void StartDefaultTask(void *argument)
{
  for(;;)
  {
    osDelay(1);
  }
}
